# ── Verus n8n — .env.example ─────────────────────────────
# Copy to .env and fill REAL values. NEVER commit .env.

# Postgres (n8n's database)
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change_me_strong
POSTGRES_DB=n8n_main

# n8n
GENERIC_TIMEZONE=Europe/Madrid
# IMPORTANT: set once; keeps workflow credentials encrypted. Never change after first boot.
N8N_ENCRYPTION_KEY=change_me_32+_chars_random

# Task runners (external python runner) — must match n8n & task-runners
N8N_RUNNERS_AUTH_TOKEN=change_me_runner_token

# MCP server auth (used by Claude Code / external MCP clients)
MCP_N8N_MCP_API_KEY=change_me_mcp_token